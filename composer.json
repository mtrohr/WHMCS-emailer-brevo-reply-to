{
    "name": "mtrohr/whmcs-mail-brevo",
    "description": "WHMCS mail provider module that sends email through the Brevo transactional API with a Reply-To on every message.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "compat": "phpcs --standard=phpcs.xml",
        "check": ["@test", "@compat"]
    }
}
